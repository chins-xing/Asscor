# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Build output
build/

# Local Go build caches (used when system GOCACHE is restricted)
.gocache/
.gotmp/

# data
data/
# 归档例外: docs/clab-lab/data 是审计实验数据, 需入库
!docs/clab-lab/data/

# Paper bundle (lunwen): local-only assets on main. Selective tracking
# (whitelist) lives on the ASSCOR-Research-Core branch; main ignores the
# whole bundle including the "lunwen - 副本" backup (lunwen*/ matches both).
lunwen/
lunwen*/

#.kilo
.kilo/

#Asscor
Asscor/

# Audit reports (generated documentation, not tracked)
#docs/audits/

# v0.3.0 optional research direction (not tracked)
docs/v0.3.0/

#.trae
.trae/

# TLS certificates and private keys
certs/

# Editor/IDE
# .idea/
# .vscode/

# Nested standalone module repositories (ssam-lib & prism-lib are independent
# Go modules vendored via go.mod replace directives). Their code files are
# tracked by this repo; these nested .git directories hold their own history
# and must never be committed or wiped by `git clean -fdx`.
ssam-lib/.git/
prism-lib/.git/
