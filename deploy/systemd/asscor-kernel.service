[Unit]
Description=ASSCOR Microkernel - Security Acceptability Assessment Engine
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=asscor
Group=asscor
ExecStart=/opt/asscor/ASSCOR-kernel \
    --config=/etc/asscor/config.ini \
    --listen=:50051 \
    --webui-port=8087 \
    --pid-file=/opt/asscor/ASSCOR-kernel.pid \
    --log-format=json \
    --log-level=info \
    --log-output=/var/log/asscor/kernel.log
ExecReload=/bin/kill -HUP $MAINPID
ExecStop=/bin/kill -SIGTERM $MAINPID
Restart=on-failure
RestartSec=10
PIDFile=/opt/asscor/ASSCOR-kernel.pid
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30
LimitNOFILE=65536
LimitNPROC=4096
ReadWritePaths=/opt/asscor /var/lib/asscor /var/log/asscor

[Install]
WantedBy=multi-user.target
