[Unit]
Description=ASSCOR Microkernel - Security Acceptability Assessment Engine
Documentation=https://github.com/asscor/asscor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=asscor
Group=asscor
WorkingDirectory=/opt/asscor
PIDFile=/opt/asscor/ASSCOR-kernel.pid
ExecStart=/opt/asscor/ASSCOR-kernel \
    --config=/opt/asscor/config.ini \
    --listen=:50051 \
    --webui-port=8087 \
    --pid-file=/opt/asscor/ASSCOR-kernel.pid \
    --log-format=json \
    --log-level=info \
    --log-output=/opt/asscor/logs/kernel.log
ExecReload=/bin/kill -HUP $MAINPID
ExecStop=/bin/kill -SIGTERM $MAINPID
Restart=on-failure
RestartSec=10
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30
LimitNOFILE=65536
LimitNPROC=4096

[Install]
WantedBy=multi-user.target
