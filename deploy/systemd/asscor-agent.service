[Unit]
Description=ASSCOR Agent - Host Security Assessment Probe
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/opt/asscor/agent/ASSCOR-agent \
    --config=/etc/asscor/agent.ini \
    --kernel=127.0.0.1:50051 \
    --log-format=text \
    --log-level=info \
    --log-output=/var/log/asscor/agent.log
Restart=always
RestartSec=15
KillMode=mixed
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
